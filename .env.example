# InsForge Configuration
# Reemplaza estos valores con las credenciales de tu proyecto InsForge
VITE_INSFORGE_BASE_URL=https://your-project.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key

# Google Gemini API Key (opcional, para el asistente IA)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Credenciales del modo demo (SOLO si InsForge no está configurado).
# Cambialas siempre; la autenticación real debe hacerse creando un usuario
# en InsForge (Dashboard > Authentication), nunca con estas variables.
VITE_DEMO_ADMIN_EMAIL=admin@losgenios.com
VITE_DEMO_ADMIN_PASSWORD=cambiar-este-password
